# Envío del formulario de socios (app/api/socios/route.ts)
#
# Sin estas variables el endpoint responde 503 y el formulario muestra el
# correo directo de la corporación, para no tragarse una postulación en
# silencio. En Vercel se cargan en Settings → Environment Variables.

# Clave del proveedor de correo transaccional (resend.com)
RESEND_API_KEY=

# Dirección verificada desde la que se envía. Tiene que pertenecer a un
# dominio verificado en el proveedor; un gmail no sirve como remitente.
CORREO_REMITENTE="Valle Cochamó <web@vallecochamo.org>"

# A dónde llegan las postulaciones. Si se omite, va al correo publicado por la
# corporación (content/cuenta.ts).
CORREO_DESTINO=
